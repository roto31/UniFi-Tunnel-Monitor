<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Tunnel Monitor</title>
    <organization>com.tunnel.monitor</organization>
    <domains enable_localSystem="true"/>
    <options customize="never" require-scripts="true" rootVolumeOnly="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="13.0"/>
        </allowed-os-versions>
    </volume-check>
    <welcome      file="welcome.html"     mime-type="text/html"/>
    <license      file="license.txt"      mime-type="text/plain"/>
    <conclusion   file="conclusion.html"  mime-type="text/html"/>
    <pkg-ref id="com.tunnel.monitor.pkg" version="__VERSION__" auth="root">__COMPONENT_PKG__</pkg-ref>
    <choices-outline>
        <line choice="default">
            <line choice="com.tunnel.monitor.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.tunnel.monitor.pkg" visible="false">
        <pkg-ref id="com.tunnel.monitor.pkg"/>
    </choice>
</installer-gui-script>
