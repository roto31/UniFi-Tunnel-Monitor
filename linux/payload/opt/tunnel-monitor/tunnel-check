#!/bin/bash
# =============================================================================
# tunnel-check - operator CLI for the Linux tunnel monitor
# =============================================================================
# Sibling of the Mac `tunnel-check` CLI. Same surface area where it makes
# sense; Linux-specific where it doesn't (systemctl vs launchctl, etc.).
# =============================================================================

set -euo pipefail

INSTALL_DIR="/opt/tunnel-monitor"
STATE_FILE="${INSTALL_DIR}/state.json"
LOG_FILE="${INSTALL_DIR}/monitor.log"
MONITOR_BIN="${INSTALL_DIR}/monitor.sh"
SEND_EMAIL_BIN="${INSTALL_DIR}/send-email.sh"
NOTIFY_BIN="${INSTALL_DIR}/notify.sh"
SSH_ROUTER_BIN="${INSTALL_DIR}/ssh-router-state.sh"
SERVICE_UNIT="tunnel-monitor.service"
TIMER_UNIT="tunnel-monitor.timer"

show_help() {
    cat <<'EOF'
tunnel-check - operator CLI for the Linux tunnel monitor

USAGE
    tunnel-check                 Pretty-print current status from state.json
    tunnel-check --check-now     Force an immediate service run
    tunnel-check --test-email    Send a synthetic test email
    tunnel-check --test-notify   Exercise notify.sh stub (logs only)
    tunnel-check --reset         Reset state.json to a fresh UP state
    tunnel-check --tail          tail -f monitor.log
    tunnel-check --history       Last 50 lines of monitor.log
    tunnel-check --ssh-test      Verify SSH-based ROUTER dedup works
    tunnel-check --status        systemctl status of the timer + service
    tunnel-check --help

FILES
    /opt/tunnel-monitor/state.json     current health state
    /opt/tunnel-monitor/monitor.log    rolling log
    /etc/systemd/system/tunnel-monitor.service
    /etc/systemd/system/tunnel-monitor.timer
EOF
}

require_root() {
    if [[ ${EUID} -ne 0 ]]; then
        echo "ERROR: this subcommand must be run as root (use sudo)" >&2
        exit 2
    fi
}

color() {
    case "${1}" in
        red)    printf '\033[1;31m%s\033[0m' "${2}" ;;
        green)  printf '\033[1;32m%s\033[0m' "${2}" ;;
        yellow) printf '\033[1;33m%s\033[0m' "${2}" ;;
        gray)   printf '\033[0;90m%s\033[0m' "${2}" ;;
        bold)   printf '\033[1m%s\033[0m'    "${2}" ;;
        *)      printf '%s' "${2}" ;;
    esac
}

next_run_human() {
    systemctl list-timers --no-pager --no-legend "${TIMER_UNIT}" 2>/dev/null \
        | awk '{print $1, $2, $3}' | head -1
}

cmd_status_pretty() {
    if [[ ! -f "${STATE_FILE}" ]]; then
        color yellow "state.json missing - service may not have run yet."
        echo
        echo "Try: sudo tunnel-check --check-now"
        exit 0
    fi
    if ! jq -e . "${STATE_FILE}" >/dev/null 2>&1; then
        color red "state.json is unparseable."
        echo
        echo "File: ${STATE_FILE}"
        exit 1
    fi

    local diagnosis alert_state failure_count timestamp
    diagnosis="$(jq -r '.diagnosis'      "${STATE_FILE}")"
    alert_state="$(jq -r '.alert_state'  "${STATE_FILE}")"
    failure_count="$(jq -r '.failure_count' "${STATE_FILE}")"
    timestamp="$(jq -r '.timestamp'      "${STATE_FILE}")"

    local color_for_state
    case "${alert_state}" in
        UP)   color_for_state="green"  ;;
        DOWN) color_for_state="red"    ;;
        *)    color_for_state="yellow" ;;
    esac

    color bold "Tunnel Monitor (Linux)"; echo
    echo "----------------------------------------------------------"
    printf '  Diagnosis:     %s\n' "$(color "${color_for_state}" "${diagnosis}")"
    printf '  Alert state:   %s\n' "$(color "${color_for_state}" "${alert_state}")"
    printf '  Failure count: %s\n' "${failure_count}"
    printf '  Last check:    %s\n' "${timestamp}"
    echo

    color bold "Checks"; echo
    jq -r '
      .checks |
      [
        ("  Tunnel       (" + .tunnel.target       + "): " + (if .tunnel.ok       then "OK ("       + (.tunnel.latency_ms       | tostring) + " ms)" else "FAIL" end)),
        ("  Remote WAN   (" + .remote_wan.target   + "): " + (if .remote_wan.ok   then "OK ("       + (.remote_wan.latency_ms   | tostring) + " ms)" else "FAIL" end)),
        ("  Our internet (" + .our_internet.target + "): " + (if .our_internet.ok then "OK ("       + (.our_internet.latency_ms | tostring) + " ms)" else "FAIL" end)),
        ("  DNS          (" + .dns.host            + "): " + (if .dns.match       then "OK (matches " + .dns.expected + ")" else "MISMATCH (" + (.dns.resolved // "<none>") + " vs " + .dns.expected + ")" end))
      ] | .[]
    ' "${STATE_FILE}"
    echo

    color bold "ROUTER dedup"; echo
    jq -r '
      .router_dedup |
      "  Reachable: " + (.reachable | tostring) + "\n" +
      "  State:     " + (.state // "<n/a>")    + "\n" +
      "  Checked:   " + .checked_at
    ' "${STATE_FILE}"
    echo

    color bold "Alert history"; echo
    printf '  Last alert:    %s\n' "$(jq -r '.last_alert_sent_at    // "never"' "${STATE_FILE}")"
    printf '  Last recovery: %s\n' "$(jq -r '.last_recovery_sent_at // "never"' "${STATE_FILE}")"
    echo

    color bold "Service"; echo
    local nrun; nrun="$(next_run_human || true)"
    printf '  Service:  %s\n' "${SERVICE_UNIT}"
    printf '  Timer:    %s\n' "${TIMER_UNIT}"
    printf '  Next run: %s\n' "${nrun:-unknown (try: systemctl list-timers ${TIMER_UNIT})}"
    echo
}

cmd_check_now() {
    require_root
    systemctl start "${SERVICE_UNIT}"
    echo "Kicked. Tail with: tunnel-check --tail"
}

cmd_test_email() {
    if [[ ! -x "${MONITOR_BIN}" ]]; then
        echo "ERROR: ${MONITOR_BIN} not executable" >&2
        exit 1
    fi
    "${MONITOR_BIN}" email-test
}

cmd_test_notify() {
    if [[ ! -x "${MONITOR_BIN}" ]]; then
        echo "ERROR: ${MONITOR_BIN} not executable" >&2
        exit 1
    fi
    "${MONITOR_BIN}" notify-test
    echo
    echo "Note: Linux notify.sh is a stub by design - see notify.sh --help."
}

cmd_reset() {
    require_root
    if [[ -f "${STATE_FILE}" ]]; then
        cp "${STATE_FILE}" "${STATE_FILE}.bak.$(date +%s)"
        echo "Backup of previous state.json saved."
    fi
    local now; now="$(date -Iseconds 2>/dev/null || date '+%Y-%m-%dT%H:%M:%S%z')"
    jq -n --arg ts "${now}" '
      {
        timestamp: $ts,
        alert_state: "UP",
        failure_count: 0,
        checks: {
          tunnel:       { target: null, ok: null, latency_ms: null },
          remote_wan:   { target: null, ok: null, latency_ms: null },
          our_internet: { target: null, ok: null, latency_ms: null },
          dns:          { host: null, resolved: null, expected: null, match: null }
        },
        router_dedup: { reachable: false, state: null, checked_at: $ts },
        last_alert_sent_at: null,
        last_recovery_sent_at: null,
        diagnosis: "RESET"
      }' > "${STATE_FILE}.tmp"
    chmod 0644 "${STATE_FILE}.tmp"
    mv "${STATE_FILE}.tmp" "${STATE_FILE}"
    echo "state.json reset to UP/0."
}

cmd_tail() {
    if [[ ! -f "${LOG_FILE}" ]]; then
        echo "Log file not present yet: ${LOG_FILE}" >&2
        exit 1
    fi
    tail -f "${LOG_FILE}"
}

cmd_history() {
    if [[ ! -f "${LOG_FILE}" ]]; then
        echo "Log file not present yet: ${LOG_FILE}" >&2
        exit 1
    fi
    tail -n 50 "${LOG_FILE}"
}

cmd_ssh_test() {
    if [[ ! -x "${SSH_ROUTER_BIN}" ]]; then
        echo "ERROR: ${SSH_ROUTER_BIN} not executable" >&2
        exit 1
    fi
    if line="$("${SSH_ROUTER_BIN}")"; then
        echo "OK: ROUTER state = ${line}"
    else
        echo "FAIL: ssh-router-state.sh failed (see above)" >&2
        exit 1
    fi
}

cmd_daemon_status() {
    echo "=== ${TIMER_UNIT} ==="
    systemctl status "${TIMER_UNIT}" --no-pager 2>/dev/null || true
    echo
    echo "=== ${SERVICE_UNIT} ==="
    systemctl status "${SERVICE_UNIT}" --no-pager 2>/dev/null || true
}

case "${1:-}" in
    ""|status)         cmd_status_pretty ;;
    --check-now)       cmd_check_now ;;
    --test-email)      cmd_test_email ;;
    --test-notify)     cmd_test_notify ;;
    --reset)           cmd_reset ;;
    --tail)            cmd_tail ;;
    --history)         cmd_history ;;
    --ssh-test)        cmd_ssh_test ;;
    --status)          cmd_daemon_status ;;
    --help|-h|help)    show_help ;;
    *)
        echo "ERROR: unknown subcommand: $1" >&2
        show_help >&2
        exit 1
        ;;
esac
