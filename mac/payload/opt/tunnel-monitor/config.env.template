# =============================================================================
# Tunnel Monitor (Mac LAN client) — Configuration
# =============================================================================
# Copy this file to /opt/tunnel-monitor/config.env (chmod 0600) and fill in
# every value marked with REPLACE_WITH_*. See ../../../PLACEHOLDERS.md for
# the full reference of what each placeholder means.
# =============================================================================

# -----------------------------------------------------------------------------
# SMTP submission (authenticated, STARTTLS on the submission port)
# -----------------------------------------------------------------------------
# iCloud:  SMTP_SERVER="smtp.mail.me.com"  SMTP_PORT="587"
# Gmail:   SMTP_SERVER="smtp.gmail.com"    SMTP_PORT="587"
# Fastmail SMTP_SERVER="smtp.fastmail.com" SMTP_PORT="587"
#
# Generate an APP-SPECIFIC PASSWORD for your account — do NOT use your main
# password. iCloud: https://account.apple.com -> Sign-In and Security ->
# App-Specific Passwords. Gmail: account security -> App passwords.
SMTP_SERVER="REPLACE_WITH_SMTP_SERVER"
SMTP_PORT="REPLACE_WITH_SMTP_PORT"
SMTP_USER="REPLACE_WITH_SMTP_USERNAME"
SMTP_PASSWORD="REPLACE_WITH_APP_SPECIFIC_PASSWORD"

# -----------------------------------------------------------------------------
# Alert addressing
# -----------------------------------------------------------------------------
# Many providers (iCloud, Fastmail) require From == authenticated user.
ALERT_FROM="REPLACE_WITH_ALERT_FROM_ADDRESS"
ALERT_TO="REPLACE_WITH_ALERT_TO_ADDRESS"

# Prepended to every Mac-originated subject. Use something distinctive so you
# can tell at a glance which vantage point caught the issue when the router
# side also alerts (e.g. "[MAC]", "[CLIENT]", "[STUDIO]").
SUBJECT_PREFIX="REPLACE_WITH_SUBJECT_PREFIX"

# -----------------------------------------------------------------------------
# Tunnel topology — what the Mac pings to test the tunnel
# -----------------------------------------------------------------------------
# REMOTE_LAN_IP : LAN gateway IP at your remote site, reachable over the
#                 tunnel from the Mac. Healthy ping == tunnel is up.
# REMOTE_WAN_IP : The public IP of your remote site. The Mac pings this
#                 directly (not over the tunnel) to disambiguate "tunnel is
#                 down" from "remote site is offline".
# REMOTE_DDNS   : DDNS hostname that should resolve to REMOTE_WAN_IP. If the
#                 resolution drifts the alert subject says so.
REMOTE_LAN_IP="REPLACE_WITH_REMOTE_LAN_GATEWAY_IP"
REMOTE_WAN_IP="REPLACE_WITH_REMOTE_PUBLIC_IP"
REMOTE_DDNS="REPLACE_WITH_REMOTE_DDNS_HOSTNAME"

# -----------------------------------------------------------------------------
# Router-side dedup (SSH to the UniFi gateway running the sibling monitor)
# -----------------------------------------------------------------------------
# The Mac reads ROUTER_STATE_PATH on the router via ssh to decide whether the
# router has already alerted; if so, the Mac suppresses its email (banner
# still fires). Setting any of these to an unreachable value makes the Mac
# alert on its own without dedup.
ROUTER_HOST="REPLACE_WITH_ROUTER_LAN_IP"
ROUTER_USER="REPLACE_WITH_ROUTER_SSH_USER"
ROUTER_KEY="/opt/tunnel-monitor/.ssh/id_ed25519"
ROUTER_STATE_PATH="/data/tunnel-monitor/state"

# -----------------------------------------------------------------------------
# Detection tuning
# -----------------------------------------------------------------------------
# FAILURE_THRESHOLD × StartInterval (default 300 s) == time-to-alert.
# With defaults: 3 × 5 min = ~15 min before the first email.
FAILURE_THRESHOLD="3"
PING_COUNT="3"
PING_TIMEOUT="2"            # seconds; converted to ms internally for BSD ping -W

# -----------------------------------------------------------------------------
# macOS notification sounds (any name from /System/Library/Sounds/ works)
# -----------------------------------------------------------------------------
NOTIFY_SOUND_DOWN="Glass"
NOTIFY_SOUND_RECOVERY="Hero"
