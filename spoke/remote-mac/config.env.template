# =============================================================================
# Tunnel Monitor (spoke LAN Mac) — config template
# =============================================================================
# Copy to /opt/tunnel-monitor/config.env (chmod 0600) on the remote-site Mac.
# See PLACEHOLDERS.md and docs/spoke-monitoring.md
# =============================================================================

SMTP_SERVER="REPLACE_WITH_SMTP_SERVER"
SMTP_PORT="REPLACE_WITH_SMTP_PORT"
SMTP_USER="REPLACE_WITH_SMTP_USERNAME"
SMTP_PASSWORD="REPLACE_WITH_APP_SPECIFIC_PASSWORD"

ALERT_FROM="REPLACE_WITH_ALERT_FROM_ADDRESS"
ALERT_TO="REPLACE_WITH_ALERT_TO_ADDRESS"

SUBJECT_PREFIX="[SPOKE-MAC]"

# Hub targets (over tunnel)
REMOTE_LAN_IP="REPLACE_WITH_HUB_LAN_GATEWAY_IP"
REMOTE_WAN_IP="REPLACE_WITH_HUB_PUBLIC_IP"
REMOTE_DDNS="REPLACE_WITH_HUB_DDNS_HOSTNAME"

# Spoke gateway — SSH dedup reads /data/tunnel-monitor/state here
ROUTER_HOST="REPLACE_WITH_SPOKE_GATEWAY_LAN_IP"
ROUTER_USER="REPLACE_WITH_ROUTER_SSH_USER"

FAILURE_THRESHOLD="3"
PING_COUNT="3"
PING_TIMEOUT="2"
