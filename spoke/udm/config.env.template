# =============================================================================
# Tunnel Monitor (spoke gateway) — config template
# =============================================================================
# Copy to /data/tunnel-monitor/config.env (chmod 0600) on the remote gateway.
# Topology is INVERTED vs the hub: ping the hub LAN over the site-to-site VPN.
# See PLACEHOLDERS.md and docs/spoke-monitoring.md
# =============================================================================

SMTP_SERVER="REPLACE_WITH_SMTP_SERVER"
SMTP_PORT="REPLACE_WITH_SMTP_PORT"
SMTP_USER="REPLACE_WITH_SMTP_USERNAME"
SMTP_PASSWORD="REPLACE_WITH_APP_SPECIFIC_PASSWORD"

ALERT_FROM="REPLACE_WITH_ALERT_FROM_ADDRESS"
ALERT_TO="REPLACE_WITH_ALERT_TO_ADDRESS"

SUBJECT_PREFIX="[SPOKE-ROUTER]"

# Hub LAN gateway — healthy == tunnel up from spoke view
REMOTE_LAN_IP="REPLACE_WITH_HUB_LAN_GATEWAY_IP"

# Hub public IP (WAN Guard–protected on dual-WAN hubs)
REMOTE_WAN_IP="REPLACE_WITH_HUB_PUBLIC_IP"

# Hostname the spoke OpenVPN tunnel dials — drift breaks the tunnel
REMOTE_DDNS="REPLACE_WITH_HUB_DDNS_HOSTNAME"

FAILURE_THRESHOLD="3"
PING_COUNT="3"
PING_TIMEOUT="2"
