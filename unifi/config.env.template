# =============================================================================
# Tunnel Monitor (UniFi gateway) — Configuration
# =============================================================================
# Copy to /data/tunnel-monitor/config.env (chmod 0600) and fill in every
# REPLACE_WITH_* value. See ../PLACEHOLDERS.md for what each one means.
# =============================================================================

# -----------------------------------------------------------------------------
# SMTP submission (authenticated, STARTTLS on the submission port)
# -----------------------------------------------------------------------------
# iCloud:   SMTP_SERVER="smtp.mail.me.com"  SMTP_PORT="587"
# Gmail:    SMTP_SERVER="smtp.gmail.com"    SMTP_PORT="587"
# Fastmail: SMTP_SERVER="smtp.fastmail.com" SMTP_PORT="587"
#
# Generate an APP-SPECIFIC PASSWORD with your provider — do NOT paste your
# account password. Most providers reject plain passwords for SMTP.
SMTP_SERVER="REPLACE_WITH_SMTP_SERVER"
SMTP_PORT="REPLACE_WITH_SMTP_PORT"
SMTP_USER="REPLACE_WITH_SMTP_USERNAME"
SMTP_PASSWORD="REPLACE_WITH_APP_SPECIFIC_PASSWORD"

# -----------------------------------------------------------------------------
# Alert addressing — From often must equal SMTP_USER (iCloud, Fastmail).
# -----------------------------------------------------------------------------
ALERT_FROM="REPLACE_WITH_ALERT_FROM_ADDRESS"
ALERT_TO="REPLACE_WITH_ALERT_TO_ADDRESS"

# Optional prefix prepended to every email subject. Use something distinctive
# so you can tell at a glance that an alert came from the router (vs. the Mac
# side, which uses its own prefix). Leave empty to keep subjects unprefixed.
# Example: "[ROUTER]"
SUBJECT_PREFIX=""

# -----------------------------------------------------------------------------
# Tunnel topology
# -----------------------------------------------------------------------------
# REMOTE_LAN_IP : LAN gateway IP at the remote site, reachable over the tunnel
# REMOTE_WAN_IP : remote site's public IP (compared to DDNS resolution)
# REMOTE_DDNS   : hostname that should resolve to REMOTE_WAN_IP
REMOTE_LAN_IP="REPLACE_WITH_REMOTE_LAN_GATEWAY_IP"
REMOTE_WAN_IP="REPLACE_WITH_REMOTE_PUBLIC_IP"
REMOTE_DDNS="REPLACE_WITH_REMOTE_DDNS_HOSTNAME"

# -----------------------------------------------------------------------------
# Detection tuning
# -----------------------------------------------------------------------------
# FAILURE_THRESHOLD × 5-minute timer = ~time-to-alert.
# Default: 3 × 5 min = ~15 min outage before the first email.
FAILURE_THRESHOLD="3"
PING_COUNT="3"
PING_TIMEOUT="2"
