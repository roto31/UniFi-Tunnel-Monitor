# =============================================================================
# wan-guard additions — append these to /data/tunnel-monitor/config.env
# (or create /data/wan-guard/config.env and source the tunnel-monitor one)
# =============================================================================

# --- WAN Guard: Interface & Hostname ---
# Primary public WAN interface on local hub. Verify with: ip -4 addr | grep inet
WAN_GUARD_INTERFACE="REPLACE_WITH_WAN_GUARD_INTERFACE"

# DDNS hostname remote site dials — must stay on public primary WAN IP
WAN_GUARD_HOSTNAME="REPLACE_WITH_HUB_DDNS_HOSTNAME"

# --- No-IP Credentials ---
WAN_GUARD_NOIP_USER="REPLACE_WITH_NOIP_USERNAME"
WAN_GUARD_NOIP_PASS="REPLACE_WITH_NOIP_PASSWORD"

# --- Optional: dry run mode (set to true to log without actually updating) ---
WAN_GUARD_DRY_RUN="false"

# --- Log rotation (lines) ---
WAN_GUARD_LOG_MAX_LINES="2000"

# =============================================================================
# NOTE: SMTP_SERVER, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, ALERT_FROM, ALERT_TO
# are inherited from the existing tunnel-monitor config.env block above this.
# wan-guard accepts ALERT_TO as ALERT_EMAIL and SMTP_PASSWORD as SMTP_PASS.
# =============================================================================
